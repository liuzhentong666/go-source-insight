PORT=8087
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=goaiinsight
# Set a generated random JWT_SECRET of at least 32 characters before startup.
JWT_SECRET=
# Default host mode accepts readable complete local directory / Go file paths.
SOURCE_ACCESS_MODE=host
# Native API can read locally; container API uses the host reader prepared by deploy.
# Reader URL/token are server-only secrets, never browser or VITE_ configuration.
SOURCE_READER_URL=
SOURCE_READER_TOKEN=
# Used by mapped mode and compatible relative API calls.
SOURCE_ROOT=sources
# Optional native API JSON (local_root plus compatible project bindings).
# Explicit mapped container workflow: deploy -SourceDirectory / --source-directory.
# Container deployments use the generated
# read-only Compose override; leave empty to retain legacy SOURCE_ROOT behavior.
SOURCE_BINDINGS_FILE=
JOB_WORKERS=2
JOB_QUEUE_SIZE=16
JOB_TIMEOUT_SECONDS=900
SHUTDOWN_TIMEOUT_SECONDS=30
# Optional explicit browser origins, separated by commas. Empty disables CORS.
CORS_ORIGINS=
