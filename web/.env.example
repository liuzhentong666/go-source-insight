# Development server only; browsers always use relative /api/v1 requests.
# Put local overrides in ignored .env.local, never use VITE_ for backend secrets.
WEB_API_PROXY_TARGET=http://127.0.0.1:8087
# Default model deadline is 300 seconds; the proxy adds 30 seconds of headroom.
WEB_PROXY_TIMEOUT_SECONDS=330
